; Installer hooks.
; The background recorder is a separate program: stop it before its files are replaced or removed.
; It is started (and registered to start with Windows) by the app's first-run setup, so nothing is
; recorded before the user has seen and accepted the settings.

; ffmpeg.exe (about 18 MB) is not a bundled resource: it is written here, and only when the copy in the install folder is not
; already this exact build. ffmpeg.nsh is generated by build-installer.ps1 (FFMPEG_ID = SHA-256, FFMPEG_SRC = the file).
!include "${__FILEDIR__}\ffmpeg.nsh"
!ifndef FFMPEG_ID
  !error "ffmpeg.nsh did not define FFMPEG_ID: build the installer with build-installer.ps1"
!endif

!macro NSIS_HOOK_PREINSTALL
  IfFileExists "$INSTDIR\buffer-recorder.exe" 0 +2
    ExecWait '"$INSTDIR\buffer-recorder.exe" quit'
  Sleep 1500
!macroend

!macro NSIS_HOOK_POSTINSTALL
  ; ffmpeg: skip the 18 MB write when the installed copy is already this build (marker file holds its hash)
  StrCpy $R0 ""
  ClearErrors
  FileOpen $R1 "$INSTDIR\ffmpeg.id" r
  IfErrors ffmpeg_write
  FileRead $R1 $R0
  FileClose $R1
  StrCmp $R0 "${FFMPEG_ID}" 0 ffmpeg_write
  IfFileExists "$INSTDIR\ffmpeg.exe" ffmpeg_done
  ffmpeg_write:
  File "/oname=$INSTDIR\ffmpeg.exe" "${FFMPEG_SRC}"
  FileOpen $R1 "$INSTDIR\ffmpeg.id" w
  FileWrite $R1 "${FFMPEG_ID}"
  FileClose $R1
  ffmpeg_done:

  ; An update stopped the recorder in PREINSTALL: restart it when the user had already completed the setup.
  IfFileExists "$APPDATA\Buffer\recorder.json" 0 +2
    Exec '"$INSTDIR\buffer-recorder.exe" run'
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  Delete "$INSTDIR\ffmpeg.exe"
  Delete "$INSTDIR\ffmpeg.id"
  ExecWait '"$INSTDIR\buffer-recorder.exe" quit'
  ExecWait '"$INSTDIR\buffer-recorder.exe" uninstall-autostart'
  ; live EQ: remove only our include line and file from Equalizer APO's config, never APO itself
  ExecWait '"$INSTDIR\buffer-recorder.exe" eq-unhook'
  Sleep 1500
!macroend
