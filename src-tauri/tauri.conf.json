{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moments Lite",
  "version": "0.1.0",
  "identifier": "dev.wheatlay.momentslite",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Moments Lite",
        "width": 1360,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
