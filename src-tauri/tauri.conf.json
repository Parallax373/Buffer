{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buffer",
  "version": "0.1.0",
  "identifier": "dev.wheatlay.buffer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Buffer",
        "width": 1400,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Wheatlay",
    "shortDescription": "Always-on clip recorder and editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/buffer-recorder.exe": "buffer-recorder.exe",
      "../vendor/ffmpeg/ffmpeg.exe": "ffmpeg.exe",
      "../vendor/ffmpeg/FFMPEG-LICENSE.txt": "FFMPEG-LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Polish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "template": "windows/installer.nsi",
        "compression": "lzma"
      }
    }
  }
}
